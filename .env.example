# --------------------------------- LLM ------------------------------------
LLM_PROVIDER = "google" # default: google (google, openai, anthropic, deepseek, ollama)
LLM_API_KEY = "gemini_api_key"
LLM_MODEL = "gemini-2.5-flash"
LLM_EMBEDDING_MODEL = "gemini-embedding-001"
LLM_OLLAMA_BASE_URL = "http://localhost:11434/api" # just for ollama provider, default: http://localhost:11434/api
LLM_SYSTEM_PROMPT = "context: {{CONTEXT}}" # must include {{CONTEXT}}
LLM_TITLE_PROMPT = "Generate a concise and descriptive title for a conversation based on the following content:\n\n{{CONTENT}}" # must include {{CONTENT}}
LLM_CONTEXT_FORMAT = "{{INDEX}}\n{{QUESTION}}\n{{ANSWER}}\n{{DOCUMENT}}" # must include {{INDEX}}, {{QUESTION}}, {{ANSWER}} and {{DOCUMENT}}
LLM_FALLBACK_MESSAGE = "Not found relevant information in the knowledge base."
LLM_EMPTY_CONTEXT_MESSAGE = "Not found relevant sources in the knowledge base."
LLM_RECENT_MESSAGES_LIMIT = "20" # default: 20
LLM_RELEVANCE_THRESHOLD = "0.8" # default: 0.8 (0.0 - 1.0)
LLM_MAX_OUTPUT_TOKENS = "1000" # default: 1000

