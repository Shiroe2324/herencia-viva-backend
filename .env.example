# ---------------------------------- APPLE ---------------------------------
APPLE_CLIENT_ID = "client_id"
APPLE_TEAM_ID = "team_id"
APPLE_KEY_ID = "key_id"
APPLE_PRIVATE_KEY = "BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APPLE_CALLBACK_URL = "http://localhost:4000/api/auth/apple/callback"
APPLE_REDIRECT_URL = "http://localhost:3000"

# --------------------------------- CHROMA ---------------------------------
# Common configuration (applies to both local and Cloud mode)
CHROMA_COLLECTION_NAME = "chroma_collection"
CHROMA_RESET_ON_START = "false" # default: false (true, false, yes, no)
CHROMA_TIMEOUT_MS = "30000" # default: 30000
CHROMA_BATCH_SIZE = "25" # default: 25

# LOCAL mode (Chroma running on your machine or your own server)
# Used when CHROMA_API_KEY, CHROMA_TENANT and CHROMA_DATABASE are left empty
CHROMA_HOST = "localhost" # default: localhost
CHROMA_PORT = "8000" # default: 8000

# CLOUD mode (Chroma Cloud - trychroma.com)
# If you set these 3, CHROMA_HOST and CHROMA_PORT are ignored and it connects to Chroma Cloud
# You must set all 3 together, or none of them
CHROMA_API_KEY = "chroma_api_key" # optional, required if using Chroma Cloud
CHROMA_TENANT = "chroma-tenant-id"
CHROMA_DATABASE = "chroma_database"

# ------------------------------- CLOUD FLARE ------------------------------
CLOUDFLARE_TUNNEL_TOKEN = "cloudflare_tunnel_token"

# -------------------------------- DATABASE --------------------------------
DATABASE_HOST = "localhost"
DATABASE_PORT = "5432"
DATABASE_NAME = "db_name"
DATABASE_USERNAME = "root"
DATABASE_PASSWORD = "password1234"
DATABASE_REJECT_UNAUTHORIZED = "false" # default: false (true, false, yes, no)
DATABASE_SSL_CA="BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----" # optional, required if DATABASE_REJECT_UNAUTHORIZED is true

# ---------------------------------- DOCS ----------------------------------
DOCS_USER = "admin" # default: admin
DOCS_PASSWORD = "password1234" # default: password1234
DOCS_NAME = "API Documentation"
DOCS_ICON = "https://nestjs.com/img/logo_text.svg" # URL to an icon image
DOCS_FAVICON = "https://nestjs.com/img/favicon.ico" # URL to a favicon image
DOCS_TITLE = "API"
DOCS_DESCRIPTION = "An API for the application. This API provides endpoints for account management, authentication, and related features, including an AI chatbot recommendation module fine-tuned for the agricultural sector."
DOCS_VERSION = "0.0.1"
DOCS_ENABLED = "true" # default: true (true, false, yes, no)

# ---------------------------------- EMAIL ---------------------------------
EMAIL_FROM = "user@example.com"
EMAIL_FROM_NAME = "No Reply"
EMAIL_CONCURRENCY_LIMIT = "5" # default: 5
EMAIL_API_KEY = "email_api_key"

# ------------------------------- ENCRYPTION -------------------------------
ENCRYPTION_ALGORITHM = "aes-256-gcm" # default: aes-256-gcm (aes-128-gcm, aes-192-gcm, aes-256-gcm)
ENCRYPTION_IV_LENGTH = "12" # default: 12 (bytes) (12, 16)
ENCRYPTION_KEY = "encryption_key" # must be 16 (bytes) for aes-128-gcm, 24 (bytes) for aes-192-gcm, 32 (bytes) for aes-256-gcm

