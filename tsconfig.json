{
  "compilerOptions": {
    "module": "commonjs",
    "esModuleInterop": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "baseUrl": "./src",
    "ignoreDeprecations": "6.0",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": true,
    "strict": true,
    "paths": {
      "@/*": ["*"],
      "@/ai/*": ["modules/shared/ai/*"],
      "@/auth/*": ["modules/auth/*"],
      "@/cache/*": ["modules/shared/cache/*"],
      "@/chroma/*": ["modules/shared/chroma/*"],
      "@/configs": ["common/configs/index.ts"],
      "@/configs/*": ["common/configs/*"],
      "@/constants": ["common/constants/index.ts"],
      "@/constants/*": ["common/constants/*"],
      "@/decorators": ["common/decorators/index.ts"],
      "@/decorators/*": ["common/decorators/*"],
      "@/enums": ["common/enums/index.ts"],
      "@/enums/*": ["common/enums/*"],
      "@/files/*": ["modules/shared/files/*"],
      "@/filters/*": ["common/filters/*"],
      "@/guards/*": ["common/guards/*"],
      "@/health/*": ["modules/health/*"],
      "@/interceptors/*": ["common/interceptors/*"],
      "@/jwt/*": ["modules/shared/jwt/*"],
      "@/llm/*": ["modules/shared/llm/*"],
      "@/mails/*": ["modules/shared/mails/*"],
      "@/models": ["common/models/index.ts"],
      "@/models/*": ["common/models/*"],
      "@/pipes/*": ["common/pipes/*"],
      "@/providers": ["common/providers/index.ts"],
      "@/providers/*": ["common/providers/*"],
      "@/recommendations/*": ["modules/recommendations/*"],
      "@/repositories/*": ["modules/shared/repositories/*"],
      "@/strategies/*": ["common/strategies/*"],
      "@/tasks/*": ["modules/shared/tasks/*"],
      "@/users/*": ["modules/users/*"],
      "@/utils": ["common/utils/index.ts"],
      "@/utils/*": ["common/utils/*"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
